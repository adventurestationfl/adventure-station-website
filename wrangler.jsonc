{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "adventure-station-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "binding": "ASSETS", "directory": "./dist", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adventure-station-local",
      "database_id": "local-only",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "adventure-station-local-media" }],
  "vars": {
    "ENVIRONMENT": "local",
    "DEV_AUTH": "false",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "SQUARE_ENVIRONMENT": "sandbox",
    "SQUARE_LOCATION_ID": "",
    "SQUARE_WEBHOOK_URL": "",
    "PUBLIC_ORIGIN": "http://127.0.0.1:4321",
  },
  "observability": { "enabled": true, "logs": { "enabled": false } },
}
