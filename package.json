{
  "name": "adventure-station",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:local": "wrangler d1 migrations apply adventure-station-local --local",
    "types": "wrangler types --strict-vars=false --include-runtime=false",
    "baseline:check": "node scripts/check-baseline.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.2",
    "astro": "7.4.2",
    "jose": "^6.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.0",
    "@cloudflare/workers-types": "^5.20261028.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.19.2",
    "miniflare": "^5.20261023.1-beta",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "wrangler": "4.154.0"
  },
  "overrides": {
    "undici": "^7.30.1",
    "@cloudflare/vite-plugin": {
      "miniflare": "5.20261023.1-beta",
      "wrangler": "4.154.0"
    }
  }
}
