---
import { localeOf, t, localPath } from '../../lib/i18n';
import { publicCatalog, publicUpcoming } from '../../lib/translations';
const locale = localeOf(Astro.locals.locale);
const href = (p: string) => localPath(p, locale);
import Public from '../../layouts/Public.astro';
import WorkshopCard from '../../components/WorkshopCard.astro';
import SessionList from '../../components/SessionList.astro';
import { env } from 'cloudflare:workers';

const workshops = await publicCatalog(env.DB, locale),
  sessions = await publicUpcoming(env.DB, locale);
---

<Public title={t('Creative workshops', locale)}>
  <div class="wrap">
    <div class="page-heading">
      <div class="eyebrow">{t('Make something wonderful', locale)}</div>
      <h1>
        {t('\r\n        A little adventure.\r\n        ', locale)}
        <br />
        {t('\r\n        All their own.\r\n      ', locale)}
      </h1>
      <p>
        {t('Explore the workshops, find a date that fits, and make space for imagination.', locale)}
      </p>
    </div>
    <section class="section">
      {workshops.length ? (
        <div class="grid">
          {workshops.map((w) => (
            <WorkshopCard workshop={w} sessions={sessions.filter((s) => s.workshop_id === w.id)} />
          ))}
        </div>
      ) : (
        <div class="empty">
          <h2>{t('New ideas are on the way.', locale)}</h2>
          <p>
            {t('\r\n            Our workshop catalog will be here soon. ', locale)}
            <a href={href('/contact')}>{t('Contact us', locale)}</a>
            {t(' for more\r\n            information.\r\n          ', locale)}
          </p>
        </div>
      )}
    </section>
    <section class="upcoming" id="dates">
      <h2>{t('Find your next date.', locale)}</h2>
      <SessionList sessions={sessions} />
    </section>
  </div>
</Public>
