---
import Public from '../../layouts/Public.astro';
import SessionList from '../../components/SessionList.astro';
import { env } from 'cloudflare:workers';
import { catalog, upcoming } from '../../lib/data';
const w = (await catalog(env.DB)).find((w) => w.slug === Astro.params.slug);
if (!w) return Astro.redirect('/404');
const sessions = await upcoming(env.DB, w.id);
const gallery = (
  await env.DB.prepare(
    'SELECT m.* FROM media m JOIN workshop_gallery g ON g.media_id=m.id WHERE g.workshop_id=? ORDER BY m.created_at',
  )
    .bind(w.id)
    .all<{ id: string; alt: string; width: number; height: number }>()
).results;
---

<Public title={w.name} description={w.summary}>
  <div class="wrap">
    <div class="breadcrumb">
      <a href="/workshops">All workshops</a> / {w.name}
    </div>
    <section class="section split">
      <div>
        <div class="eyebrow">{w.category}</div>
        <h1>{w.name}</h1>
        <p>{w.summary}</p>
        <span class="tag">
          Ages {w.age_min}–{w.age_max} · {w.duration} minutes
        </span>
        <p class="prose">{w.description}</p>
        {w.materials && (
          <>
            <h3>Materials</h3>
            <p>{w.materials}</p>
          </>
        )}
        {w.instructions && (
          <>
            <h3>Before you come</h3>
            <p>{w.instructions}</p>
          </>
        )}
        <a class="btn coral" href="#dates">
          Find a date ↗
        </a>
      </div>
      <div class="hero-art">
        <img
          src={w.media_id ? `/media/${w.media_id}?w=960` : '/brand/art-960.webp'}
          alt={w.image_alt ?? 'Adventure Station arts and crafts artwork'}
          width="960"
          height="960"
        />
      </div>
    </section>
    {gallery.length > 0 && (
      <section class="section">
        <h2>A closer look.</h2>
        <div class="grid">
          {gallery.map((m) => (
            <img
              src={`/media/${m.id}?w=480`}
              alt={m.alt}
              width={m.width}
              height={m.height}
              loading="lazy"
            />
          ))}
        </div>
      </section>
    )}
    <section id="dates" class="upcoming">
      <h2>Let’s make a date.</h2>
      <SessionList sessions={sessions} />
    </section>
  </div>
</Public>
