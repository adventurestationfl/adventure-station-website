---
import { localeOf, t, localPath } from '../lib/i18n';
import { localizedSite } from '../lib/translations';
const locale = localeOf(Astro.locals.locale);
const href = (p: string) => localPath(p, locale);
import Public from '../layouts/Public.astro';
import { env } from 'cloudflare:workers';
const page = Astro.params.page,
  site = await localizedSite(env.DB, locale);
const titles: Record<string, string> = {
  about: 'A place for big little ideas.',
  faq: 'A few good things to know.',
  policies: 'Privacy & workshop policies.',
  contact: 'Let’s make a connection.',
};
const rawTitle = titles[page ?? ''];
const title = rawTitle ? t(rawTitle, locale) : undefined;
if (!title) {
  Astro.response.status = 404;
}
const venues = (
  await env.DB.prepare(
    'SELECT name,address,instructions FROM venues WHERE verified=1 AND archived=0 ORDER BY name',
  ).all<{ name: string; address: string; instructions: string }>()
).results;
---

<Public title={title ?? 'Page not found'}>
  <div class="wrap">
    <div class="page-heading">
      <div class="eyebrow">{t('Adventure Station', locale)}</div>
      <h1>{title ?? t('This page wandered off.', locale)}</h1>
    </div>
    <section class="section prose">
      {page === 'about' && (
        <>
          <h2>{t('For the joy of discovering.', locale)}</h2>
          <p>{site.about}</p>
          <p>
            {t(
              'Creative projects, sensory exploration, science-inspired experiments and playful challenges can share the same adventure.',
              locale,
            )}
          </p>
          <a class="btn" href={href('/workshops')}>
            {t('\r\n            Explore workshops ↗\r\n          ', locale)}
          </a>
        </>
      )}
      {(page === 'faq' || page === 'policies') && (
        <>
          {page === 'faq' && (
            <>
              {site.faqs.map((f) => (
                <details>
                  <summary>{f.question}</summary>
                  <p>{f.answer}</p>
                </details>
              ))}
            </>
          )}
          <h2>{t('Before you register', locale)}</h2>
          {!site.policiesApproved && (
            <div class="policy-pending">
              {t(
                '\r\n              Workshop policies are awaiting owner confirmation. Please contact us before making\r\n              plans.\r\n            ',
                locale,
              )}
            </div>
          )}
          {[
            ['Cancellations & refunds', site.refundPolicy],
            ['Guardian supervision', site.supervisionPolicy],
            ['Drop-off & pickup', site.pickupPolicy],
            ['Privacy & your information', site.privacyPolicy],
          ].map(([heading, value]) => (
            <article>
              <h3>{t(heading!, locale)}</h3>
              <p>
                {(site.policiesApproved ? value : '') ||
                  (site.policiesApproved
                    ? t('Please contact us for details.', locale)
                    : t('Awaiting owner confirmation.', locale))}
              </p>
            </article>
          ))}
        </>
      )}
      {page === 'contact' && (
        <>
          <p>
            {t(
              '\r\n            Questions about workshops, upcoming dates, or joining in? We’d love to hear from you.\r\n          ',
              locale,
            )}
          </p>
          <h2>{t('Say hello.', locale)}</h2>
          <p>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
          {site.phone && <p>{site.phone}</p>}
          <h2>{t('Where adventures happen.', locale)}</h2>
          {site.locality && <p>{site.locality}</p>}
          {venues.length ? (
            venues.map((v) => (
              <article>
                <h3>{v.name}</h3>
                <p>{v.address}</p>
                <p>{v.instructions}</p>
              </article>
            ))
          ) : (
            <p>
              {t(
                '\r\n              Venue details will be shared with each published workshop date. Please contact us to\r\n              confirm the location.\r\n            ',
                locale,
              )}
            </p>
          )}
        </>
      )}
      {!title && (
        <>
          <p>{t('Let’s get you back to something creative.', locale)}</p>
          <a class="btn" href={href('/')}>
            {t('\r\n            Back to home\r\n          ', locale)}
          </a>
        </>
      )}
    </section>
  </div>
</Public>
