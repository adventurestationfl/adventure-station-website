---
import '../../styles/global.css';
import '../../styles/admin.css';
import { env } from 'cloudflare:workers';
import { localeOf, t } from '../../lib/i18n';
import { staffNavigation, navigationIcons } from '../../lib/admin-navigation';
const staff = Astro.locals.staff!,
  section = Astro.params.section || (staff.role === 'instructor' ? 'sessions' : 'dashboard');
const locale = localeOf(staff.locale),
  groups = staffNavigation(staff.role);
const sectionLabel =
  section === 'settings'
    ? 'Personal preferences'
    : section === 'connections'
      ? 'AI Connections'
      : groups.flatMap((g) => g.items).find((i) => i.section === section)?.label || 'Studio desk';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{t("Studio desk | Adventure Station",locale)}</title>
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body>
    <a href="#admin-main" class="skip">
      {t('\n      Skip to workspace\n    ', locale)}
    </a>
    <div class="admin-shell">
      <header class="admin-mobile-header">
        <a class="brand" href={staff.role === 'instructor' ? '/admin/sessions' : '/admin'}>
          <img src="/brand/logo-96.webp" width="36" height="36" alt="" />
          <span>
            Adventure Station<small>{t('Studio desk', locale)}</small>
          </span>
        </a>
        <button
          class="admin-menu-toggle"
          aria-label={t('Workspace menu', locale)}
          aria-controls="staff-drawer"
          aria-haspopup="dialog"
          aria-expanded="false"
          hidden
        >
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            aria-hidden="true"
          >
            <path d="M4 6h16 M4 12h16 M4 18h16" />
          </svg>
          <span>{t('Menu', locale)}</span>
        </button>
      </header>
      <aside class="sidebar" id="desktop-navigation-slot">
        <div class="navigation-content" id="navigation-content">
          <a
            class="brand navigation-brand"
            href={staff.role === 'instructor' ? '/admin/sessions' : '/admin'}
          >
            <img src="/brand/logo-96.webp" width="40" height="40" alt="" />
            <span>
              Adventure Station<small>{t('Studio desk', locale)}</small>
            </span>
          </a>
          <nav id="staff-menu" aria-label={t('Staff navigation', locale)}>
            {groups.map((group, index) => (
              <section class="nav-group" aria-labelledby={`navigation-group-${index}`}>
                <h2 class="nav-group-title" id={`navigation-group-${index}`}>
                  {t(group.name, locale)}
                </h2>
                <ul class="admin-nav" role="list">
                  {group.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        aria-current={section === item.section ? 'page' : undefined}
                      >
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linejoin="round"
                          stroke-linecap="round"
                          aria-hidden="true"
                        >
                          <path d={navigationIcons[item.icon]} />
                        </svg>
                        <span>{t(item.label, locale)}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </nav>
          <div class="sidebar-bottom">
            <div class="staff-identity">
              <span class="staff-avatar" aria-hidden="true">
                {staff.name.trim().charAt(0).toUpperCase()}
              </span>
              <div>
                <strong>{staff.name}</strong>
                <small>
                  {t(
                    staff.role === 'godmin'
                      ? 'Godmin'
                      : staff.role.charAt(0).toUpperCase() + staff.role.slice(1),
                    locale,
                  )}
                </small>
              </div>
            </div>
            <a
              class="account-preferences"
              href="/admin/settings"
              aria-current={section === 'settings' ? 'page' : undefined}
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
              >
                <path d={navigationIcons.settings} />
              </svg>
              {t('Preferences & language', locale)}
            </a>
            <a class="sign-out" href="/cdn-cgi/access/logout">
              {t('Sign out', locale)}
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </aside>
      <dialog class="nav-drawer" id="staff-drawer" aria-labelledby="drawer-title" aria-modal="true">
        <div class="drawer-heading">
          <h2 id="drawer-title">{t('Workspace menu', locale)}</h2>
          <button
            type="button"
            data-close-navigation
            aria-label={t('Close navigation', locale)}
            autofocus
          >
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              aria-hidden="true"
            >
              <path d="m6 6 12 12 M18 6 6 18" />
            </svg>
            <span>{t('Close', locale)}</span>
          </button>
        </div>
        <div id="drawer-navigation-slot" class="drawer-navigation-slot"></div>
      </dialog>
      <div class="admin-body">
        {env.ENVIRONMENT !== 'production' && (
          <div class="preview-note">
            {t(
              '\n            Preview workspace. Use synthetic information only. Live payments and customer emails are\n            disabled.\n          ',
              locale,
            )}
          </div>
        )}
        <header class="admin-top">
          <span>
            {t('Studio desk / ', locale)}
            {t(sectionLabel, locale)}
          </span>
          <a href="/" target="_blank" rel="noopener">
            {t('\n            View website\n          ', locale)}
          </a>
        </header>
        <main
          id="admin-main"
          class="admin-main"
          data-section={section}
          data-role={staff.role}
          data-locale={locale}
        >
          <div id="admin-message" role="status" aria-live="polite" class="notice"></div>
          <div id="workspace">
            <div class="loading">{t('Opening your workspace…', locale)}</div>
          </div>
        </main>
        <footer class="admin-signature">Made with love by your Bro · 2026</footer>
      </div>
    </div>
    <script src="../../scripts/admin-navigation.ts" />
    <script src="../../scripts/admin.ts" />
  </body>
</html>
