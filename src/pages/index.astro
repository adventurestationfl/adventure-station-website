---
import { localeOf, t, localPath } from '../lib/i18n';
import { localizedSite, publicCatalog, publicUpcoming } from '../lib/translations';
const locale = localeOf(Astro.locals.locale);
const href = (p: string) => localPath(p, locale);
import Public from '../layouts/Public.astro';
import WorkshopCard from '../components/WorkshopCard.astro';
import SessionList from '../components/SessionList.astro';
import { env } from 'cloudflare:workers';

const site = await localizedSite(env.DB, locale),
  workshops = await publicCatalog(env.DB, locale),
  sessions = await publicUpcoming(env.DB, locale);
const heroAlt = site.heroMediaId
  ? (
      await env.DB.prepare('SELECT alt FROM media WHERE id=?')
        .bind(site.heroMediaId)
        .first<{ alt: string }>()
    )?.alt
  : 'Adventure Station’s colorful arts and crafts characters';
---

<Public>
  <div class="wrap">
    <section class="hero">
      <div>
        <div class="maker-strip" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <h1>
          {site.headline === 'A little mess. A lot of imagination.' ? (
            <>
              {t('\r\n              A little mess.\r\n              ', locale)}
              <br />
              {t('A lot of imagination.\r\n            ', locale)}
            </>
          ) : (
            site.headline
          )}
        </h1>
        <p>{site.intro}</p>
        <div class="hero-actions">
          <a class="btn coral" href={href('/workshops')}>
            {t('\r\n            Explore workshops ', locale)}
            <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href={href('/about')}>
            {t('\r\n            Meet Adventure Station\r\n          ', locale)}
          </a>
        </div>
        <div class="hero-note">
          {t('Arts and crafts in ', locale)}
          {site.locality || 'Florida'}
        </div>
      </div>
      <div class="hero-art">
        <img
          src={site.heroMediaId ? `/media/${site.heroMediaId}?w=960` : '/brand/art-960.webp'}
          srcset={
            site.heroMediaId
              ? `/media/${site.heroMediaId}?w=480 480w, /media/${site.heroMediaId}?w=960 960w`
              : '/brand/art-480.webp 480w, /brand/art-960.webp 960w'
          }
          sizes="(max-width:720px) 85vw, 45vw"
          width="960"
          height="960"
          alt={heroAlt}
          fetchpriority="high"
        />
        <span class="art-label">{t('Big ideas start with little hands.', locale)}</span>
      </div>
    </section>
    <div class="ribbon" aria-label={t('Workshop themes', locale)}>
      <span>
        <b aria-hidden="true">✦</b>
        {t(' Hands-on making\r\n      ', locale)}
      </span>
      <span>
        <b aria-hidden="true">✦</b>
        {t(' Room to explore\r\n      ', locale)}
      </span>
      <span>
        <b aria-hidden="true">✦</b>
        {t(' Seasonal inspiration\r\n      ', locale)}
      </span>
      <span>
        <b aria-hidden="true">✦</b>
        {t(' Made with imagination\r\n      ', locale)}
      </span>
    </div>
    <section class="section">
      <div class="section-head">
        <div>
          <div class="eyebrow">{t('Pick a little adventure', locale)}</div>
          <h2>
            {t('\r\n            What will they\r\n            ', locale)}
            <br />
            {t('\r\n            make next?\r\n          ', locale)}
          </h2>
        </div>
        <p>
          {t(
            '\r\n          A new idea. A splash of color. Something to call their own. Explore our creative\r\n          workshops.\r\n        ',
            locale,
          )}
        </p>
      </div>
      {workshops.length ? (
        <div class="grid">
          {workshops.slice(0, 3).map((w) => (
            <WorkshopCard workshop={w} sessions={sessions.filter((s) => s.workshop_id === w.id)} />
          ))}
        </div>
      ) : (
        <div class="empty">
          <h3>{t('Something creative is taking shape.', locale)}</h3>
          <p>
            {t(
              'We’re preparing our next workshops. Check back soon or get in touch to learn more.',
              locale,
            )}
          </p>
          <a class="text-link" href={href('/contact')}>
            {t('\r\n            Contact Adventure Station ↗\r\n          ', locale)}
          </a>
        </div>
      )}
      <div class="upcoming" id="dates">
        <div class="eyebrow">{t('Coming up', locale)}</div>
        <SessionList sessions={sessions.slice(0, 4)} />
      </div>
    </section>
    <section class="section split">
      <div class="story-panel">
        {t('\r\n        Not every masterpiece\r\n        ', locale)}
        <br />
        {t('\r\n        belongs in a museum.\r\n        ', locale)}
        <br />
        <em>
          {t('\r\n          Some belong on\r\n          ', locale)}
          <br />
          {t('\r\n          your fridge.\r\n        ', locale)}
        </em>
        <div class="mini">{t('A LITTLE WONDER GOES A LONG WAY.', locale)}</div>
      </div>
      <div>
        <div class="eyebrow">{t('More than the finished project', locale)}</div>
        <h2>
          {t('\r\n          The magic is\r\n          ', locale)}
          <br />
          {t('\r\n          in the making.\r\n        ', locale)}
        </h2>
        <p>{site.about}</p>
        <p>
          {t(
            '\r\n          There’s joy in trying something new, choosing your own colors, and seeing an idea become\r\n          something you can hold.\r\n        ',
            locale,
          )}
        </p>
        <a class="text-link" href={href('/about')}>
          {t('\r\n          A little about us ↗\r\n        ', locale)}
        </a>
      </div>
    </section>
    <section class="section">
      <div class="section-head">
        <div>
          <div class="eyebrow">{t('Simple from the start', locale)}</div>
          <h2>{t('From “let’s go” to “look what I made!”', locale)}</h2>
        </div>
      </div>
      <div class="steps">
        <article>
          <span class="step-number">01.</span>
          <h3>{t('Find their next adventure', locale)}</h3>
          <p>
            {t(
              '\r\n            Explore the workshops. Check the age range, project details, and available class dates.\r\n          ',
              locale,
            )}
          </p>
        </article>
        <article>
          <span class="step-number">02.</span>
          <h3>{t('Choose a date together', locale)}</h3>
          <p>
            {t(
              '\r\n            A parent or guardian registers the children and pays through secure hosted checkout.\r\n          ',
              locale,
            )}
          </p>
        </article>
        <article>
          <span class="step-number">03.</span>
          <h3>{t('Let creativity take over', locale)}</h3>
          <p>
            {t(
              '\r\n            Check your confirmed registration and class instructions. Then get ready to make\r\n            something special.\r\n          ',
              locale,
            )}
          </p>
        </article>
      </div>
    </section>
    <section class="cta-band">
      <h2>{site.promotion}</h2>
      <a class="btn" href={href('/workshops')}>
        {t('\r\n        Find a workshop ', locale)}
        <span aria-hidden="true">↗</span>
      </a>
    </section>
  </div>
</Public>
