---
import Public from '../../layouts/Public.astro';
import { env } from 'cloudflare:workers';
import { marketingPreference } from '../../lib/marketing-preferences';
import { localeOf, t } from '../../lib/i18n';
const locale = localeOf(Astro.locals.locale),
  tr = (s: string) => t(s, locale);
// A high-entropy, narrowly scoped revocation capability authorizes this action.
// GET never mutates preferences; POST can only stop marketing, never subscribe,
// access a booking, or change transactional delivery. No ambient staff cookie.
const result = await marketingPreference(
  env.DB,
  Astro.params.token ?? '',
  Astro.request.method === 'POST',
);
if (!result.valid) Astro.response.status = 410;
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<Public title="Marketing preferences">
  <section class="section narrow">
    <h1>{tr('Marketing preferences')}</h1>
    {result.valid ? (
      result.stopped ? (
        <p role="status">
          {tr('Promotional messages are stopped. Essential booking messages are unaffected.')}
        </p>
      ) : (
        <>
          <p>
            {tr(
              'Stop future promotional messages for the address associated with this link. Essential booking messages are unaffected.',
            )}
          </p>
          <form method="post">
            <button type="submit" class="btn">
              {tr('Stop promotional messages')}
            </button>
          </form>
        </>
      )
    ) : (
      <p>
        {tr(
          'This preference link is unavailable or expired. Contact Adventure Station to stop promotional messages.',
        )}
      </p>
    )}
  </section>
</Public>
