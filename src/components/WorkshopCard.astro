---
import { money, dateLabel } from '../lib/data';
const { workshop: w, sessions = [] } = Astro.props;
const next = sessions[0];
---

<a class="workshop-card" href={`/workshops/${w.slug}`}>
  <div class="card-image">
    <img
      src={w.media_id ? `/media/${w.media_id}?w=480` : '/brand/art-480.webp'}
      alt={w.image_alt ?? 'Adventure Station crafts and arts artwork'}
      width="480"
      height="480"
      loading="lazy"
    />
  </div>
  <div class="card-body">
    <span class="tag">{w.category}</span>
    <h3>{w.name}</h3>
    <p>{w.summary}</p>
    <div class="card-facts">
      <p>
        Ages {w.age_min}–{w.age_max}. {w.duration} minutes.
      </p>
      {next ? (
        <>
          <p>{dateLabel(next.starts_at, next.timezone)}</p>
          <p>{next.venue_name}</p>
          <p>
            <strong>{money(next.price)} per child</strong> ·{' '}
            {Math.max(0, next.capacity - next.occupied)} places available
          </p>
        </>
      ) : (
        <p>New dates will appear here when ready.</p>
      )}
    </div>
    <div class="card-foot">
      <span>View workshop</span>
      <span aria-hidden="true">↗</span>
    </div>
  </div>
</a>
