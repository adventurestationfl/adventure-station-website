---
import { money, dateLabel } from '../lib/data';
const { sessions } = Astro.props;
---

{sessions.length ? (
  sessions.map((s: Record<string, any>) => (
    <article class="session-row">
      <div>
        <h3>{s.workshop_name}</h3>
        <p class="session-date">
          <time datetime={new Date(s.starts_at * 1000).toISOString()}>
            {dateLabel(s.starts_at, s.timezone)}{' '}
            {
              new Intl.DateTimeFormat('en-US', { timeZone: s.timezone, timeZoneName: 'short' })
                .formatToParts(s.starts_at * 1000)
                .find((p) => p.type === 'timeZoneName')?.value
            }
          </time>
        </p>
        <p>
          {s.venue_name} · Ages {s.age_min}–{s.age_max}
        </p>
      </div>
      <div class="session-info">
        <p>
          {money(s.price)} per child · {Math.max(0, s.capacity - s.occupied)} places available
        </p>
        <a class="btn small" href={`/register/${s.id}`}>
          {s.occupied >= s.capacity ? 'View full class' : 'Choose this date'}{' '}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </article>
  ))
) : (
  <div>
    <h3>Our next adventure is on its way.</h3>
    <p>
      New workshop dates will appear here as soon as they’re ready. Get in touch to ask about what’s
      coming up.
    </p>
    <a class="text-link" href="/contact">
      Say hello <span aria-hidden="true">↗</span>
    </a>
  </div>
)}
